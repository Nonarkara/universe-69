: "") + "</div>" +\n    \'<div class="row"><b class="l">LAGOON</b> \' + esc(worldLines("lagoon", l).slice(1).join(" · ")) +\n      (topActs(l) ? \' · <span class="now">\' + esc(topActs(l)) + "</span>" : "") + "</div>";\n  if (html !== hudLast) { hudLast = html; el.innerHTML = html; }\n  updateNav();\n}\n\nfunction updateNav() {\n  const set = (id, on) => {\n    const b = $(id); if (!b) return;\n    b.classList.toggle("on", !!on);\n  };\n  set("bTable", mode.view === "table");\n  set("bEden", mode.view === "inside" && mode.active === "eden");\n  set("bLagoon", mode.view === "inside" && mode.active === "lagoon");\n  set("bTime", held.on);\n  const bt = $("bTime");\n  if (bt) bt.textContent = held.on ? "CONTINUE" : "REAL-TIME";\n}\n\nlet slate = null;\nfunction makeSlate() {\n  const c = document.createElement("canvas");\n  c.width = 1024; c.height = 320;\n  const tex = new THREE.CanvasTexture(c);\n  tex.colorSpace = THREE.SRGBColorSpace;\n  const mat = new THREE.MeshBasicMaterial({ map: tex, transparent: true,\n    depthTest: false, depthWrite: false, toneMapped: false });\n  const mesh = new THREE.Mesh(new THREE.PlaneGeometry(0.92, 0.2875), mat);\n  mesh.position.set(0, -0.34, -1.05);\n  mesh.renderOrder = 999;\n  mesh.visible = false;\n  camera.add(mesh);\n  return { canvas: c, ctx: c.getContext("2d"), tex, mesh, sig: "" };\n}\n\nfunction updateSlate() {\n  if (!state || !camera) return;\n  if (!slate) slate = makeSlate();\n  const e = state.u.eden, l = state.u.lagoon;\n  const viewName = mode.view === "table" ? "TABLE"\n    : "INSIDE " + String(mode.active || "").toUpperCase();\n  const years = (state.pace && +state.pace.years_per_real_day) || 100;\n  const when = held.on ? "REAL-TIME · RECORD HELD"\n    : "TIMELAPSE · " + (+years.toPrecision(3)) + " YEARS / REAL DAY";\n  const sig = [viewName, when, e.year, e.tod, e.pop, e.phase,\n               l.year, l.tod, l.pop, l.season, (l.settlements || []).length].join("|");\n  if (sig === slate.sig) return;\n  slate.sig 