ch: 0.46, dist: 3.85 };\nconst look = { yaw: 0, pitch: -0.04 };\nconst playerAt = { x: 0, y: 0, z: 0 };\nconst EYE = 1.62;\n\nfunction spawnFor(key) {\n  const S = worldSize(key);\n  if (key === "eden") return { x: 0, z: Math.min(7.5, S * 0.18), yaw: 0, pitch: -0.02 };\n  const camps = worldOf("lagoon") && worldOf("lagoon").settlements || [];\n  if (!camps.length) return { x: 0, z: 6, yaw: 0, pitch: -0.02 };\n  let best = camps[0];\n  camps.forEach((c) => { if ((c.n || c.mouths || 0) > (best.n || best.mouths || 0)) best = c; });\n  const cx = best.x - S / 2, cz = best.y - S / 2;\n  const offsets = [[-4.5, 4.5], [4.5, 4.5], [-4.5, -4.5], [4.5, -4.5], [0, 5.5], [5.5, 0],\n                   [-5.5, 0], [0, -5.5], [6.5, 2], [-6.5, -2]];\n  for (const [dx, dz] of offsets) {\n    const x = clamp(cx + dx, -S / 2 + 2, S / 2 - 2);\n    const z = clamp(cz + dz, -S / 2 + 2, S / 2 - 2);\n    if (groundAt("lagoon", x, z) > 0.2) {\n      return { x, z, yaw: Math.atan2(-(cx - x), -(cz - z)), pitch: -0.03 };\n    }\n  }\n  return { x: cx, z: cz, yaw: 0, pitch: -0.03 };\n}\n\nfunction groundAt(key, x, z) {\n  const S = worldSize(key);\n  if (key === "lagoon") {\n    const h = surfaceY("lagoon", clamp(x + S / 2, 0, S - 0.01),\n                                clamp(z + S / 2, 0, S - 0.01));\n    return h + 0.03;\n  }\n  return 0.01;\n}\n\nfunction clampToWorld(key, x, z) {\n  const S = worldSize(key), m = 1.8;\n  return [clamp(x, -S / 2 + m, S / 2 - m), clamp(z, -S / 2 + m, S / 2 - m)];\n}\n\nfunction layout() {\n  if (!table || !worlds.eden || !worlds.lagoon) return;\n  const inTable = mode.view === "table";\n  table.visible = inTable;\n  sky.visible = !inTable;\n  ["eden", "lagoon"].forEach((key) => {\n    const g = worlds[key];\n    if (!g) return;\n    g.visible = inTable || mode.active === key;\n    if (inTable) {\n      const slot = tableSlot(key);\n      g.scale.setScalar(key === "eden" ? EDEN_TABLE : LAGOON_TABLE);\n      g.position.set(slot.x, 0.055, slot.z);\n      g.rotatio