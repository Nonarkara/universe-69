;\n  if (key === "eden") {\n    const f = u.facilities || {};\n    return [u.iter, u.size || 48, (u.boxes_xy || []).length,\n            fac(f.pool), fac(f.bar), fac(f.theater), fac(f.field)].join("|");\n  }\n  const huts = [];\n  (u.settlements || []).forEach((st) => (st.huts || []).forEach((h) => {\n    if (h.done !== false && (h.done || (h.w || 0) >= 10)) huts.push(h.x + "," + h.y);\n  }));\n  const camp = (u.camp_state || []).map((c) =>\n    c ? [c.fire ? 1 : 0, c.granary ? 1 : 0, c.writing ? 1 : 0].join("") : "-").join(".");\n  return [worldInfo && worldInfo.lagoon_iter, (u.settlements || []).length,\n          huts.join("."), camp, (u.boats || []).length, (u.farms || []).length,\n          Math.ceil((u.animals || []).length / 128)].join("|");\n}\n\nfunction onRecord(st) {\n  ["eden", "lagoon"].forEach((key) => {\n    const g = ensureGroup(key);\n    const u = worldOf(key);\n    const sig = worldSig(key, u);\n    if (!g.userData.built || g.userData.sig !== sig) {\n      buildWorld(key);\n    } else {\n      refreshWorld(key, u);\n    }\n  });\n  updateLabels();\n  updateHUD();\n  updateSlate();\n  applyTime(worldOf(mode.view === "inside" ? mode.active : "eden"));\n}\n\nfunction buildWorld(key) {\n  const g = ensureGroup(key);\n  const u = worldOf(key);\n  // replace only the static picture; the crowd keeps its people and their\n  // walking history across a rebuild\n  if (g.userData.static) {\n    g.remove(g.userData.static);\n    disposeTree(g.userData.static);\n  }\n  const s = new THREE.Group();\n  g.add(s);\n  g.userData.static = s;\n  if (key === "eden") buildEdenInto(s, u);\n  else buildLagoonInto(s, u);\n  g.userData.built = true;\n  g.userData.sig = worldSig(key, u);\n  if (!g.userData.crowd) {\n    const c = new Crowd(key, u);\n    g.add(c.group);\n    g.userData.crowd = c;\n  } else {\n    g.userData.crowd.setSource(u);\n    g.userData.crowd.size = worldSize(key);\n  }\n  refreshWorld(key, u);\n  layout();\n}\n\nfunction disposeTree(root) {\n  root.traverse((o) => {\n    if (o.geometry) o.geometry.dispose();\n    if (o.material) {\n      if (Array.isArray(o.material)) o.material.forEach((m) => m.dispose());\n      else o.material.dispose();\n    }\n  });\n}\n\nfunction refreshWorld(key, u) {\n  const g = ensureGroup(key);\n  const s = g.userData.static;\n  if (!s || !u) return;\n  const crowd = g.userData.crowd;\n  if (crowd) { crowd.setSource(u); crowd.size = worldSize(key); }\n  if (key === "eden") {\n    const roofs = s.userData.roofs;\n    if (roofs) {\n      const col = new THREE.Color();\n      (u.boxes_xy || []).forEach((b, i) => {\n        const occ = (u.box_occ && u.box_occ[String(i)]) || 0;\n        col.setHex(occ > 0 ? 0xb08050 : 0x8d6a42);\n        roofs.setColorAt(i, col);\n      });\n      if (roofs.instanceColor) roofs.instanceColor.needsUpdate = true;\n    }\n    const lamps = s.userData.lamps;\n    if (lamps) lamps.visible = !!u.night;\n  } else {\n    updateBeasts(s, u);\n  }\n}\n\n// ---- EDEN: a sealed resort, drawn from the record\'s own plan -----------------\nfunction edenGroundTexture(u, S) {\n  const N = 1024, c = document.createElement("canvas");\n  c.width = c.height = N;\n  const g = c.getContext("2d");\n  const px = N / S;\n  g.fillStyle = "#5f7d43"; g.fillRect(0, 0, N, N);\n  // grass grain: a handful of tones, not a flat fill\n  for (let i = 0; i < 26000; i++) {\n    const x = Math.random() * N, y = Math.random() * N, r = Math.random() * 2.2 + 0.4;\n    g.fillStyle = ["#56733c", "#68864a", "#728f52", "#4f6c37"][(Math.random() * 4) | 0];\n    g.globalAlpha = 0.20 + Math.random() * 0.30;\n    g.fillRect(x, y, r, r);\n  }\n  g.globalAlpha = 1;\n  // mown bands, the way a resort lawn is cut\n  for (let i = 0; i < S; i += 6) {\n    g.fillStyle = "rgba(255,255,255,0.022)";\n    g.fillRect(0, i * px, N, 3 * px);\n  }\n  // the paths: a cross through the pen and a ring round the middle\n  g.strokeStyle = "#c9b98d"; g.lineWidth = 2.5 * px; g.lineCap = "round";\n  g.beginPath(); g.moveTo(N / 2, 0); g.lineTo(N / 2, N);\n  g.moveTo(0, N / 2); g.lineTo(N, N / 2); g.stroke();\n  g.strokeStyle = "#cdbd92"; g.lineWidth = 2.2 * px;\n  g.beginPath(); g.arc(N / 2, N / 2, 16 * px, 0, Math.PI * 2); g.stroke();\n  // the central plaza and the four food courts\n  g.fillStyle = "#cdbd92";\n  g.beginPath(); g.arc(N / 2, N / 2, 5.2 * px, 0, Math.PI * 2); g.fill();\n  [[8, 8], [40, 8], [8, 40], [40, 40]].forEach(([x, y]) => {\n    g.beginPath(); g.arc(x * px, y * px, 2.6 * px, 0, Math.PI * 2); g.fill();\n  });\n  // cabana pads: the plan\'s own boxes, not an invented ring\n  (u.boxes_xy || []).forEach(([x, y]) => {\n    g.fillStyle = "rgba(70,58,40,0.32)";\n    g.fillRect((x - 1.4) * px, (y - 1.4) * px, 2.8 * px, 2.8 * px);\n  });\n  const tex = new THREE.CanvasTexture(c);\n  tex.colorSpace = THREE.SRGBColorSpace;\n  tex.anisotropy = 4;\n  return tex;\n}\n\nfunction buildEdenInto(g, u) {\n  if (!u) return;\n  const S = u.size || 48, h = S / 2;\n  const ground = new THREE.Mesh(\n    new THREE.PlaneGeometry(S, S),\n    new THREE.MeshStandardMaterial({ map: edenGroundTexture(u, S), roughness: 0.94 }));\n  ground.rotation.x = -Math.PI / 2; ground.position.y = 0.005;\n  ground.receiveShadow = true;\n  g.add(ground);\n  g.userData.S = S;\n  g.userData.ground = 0.005;\n\n  // the wall that makes the universe sealed: a clipped hedge with gates\n  const hedge = new THREE.MeshStandardMaterial({ color: 0x2f4a2a, roughness: 1 });\n  const postMat = new THREE.MeshStandardMaterial({ color: 0x6b5a3c, roughness: 0.9 });\n  for (let side = 0; side < 4; side++) {\n    for (let half = 0; half < 2; half++) {\n      const len = S / 2 - 4;\n      const geo = new THREE.BoxGeometry(len, 0.85, 0.55);\n      const m = new THREE.Mesh(geo, hedge);\n      m.castShadow = true; m.receiveShadow = true;\n      if (side < 2) {\n        m.rotation.y = Math.PI / 2;\n        m.position.set((side ? 1 : -1) * (h - 1.7), 0.42, (half ? 1 : -1) * (len / 2 + 2));\n      } else {\n        m.position.set((half ? 1 : -1) * (len / 2 + 2), 0.42, (side === 2 ? 1 : -1) * (h - 1.7));\n      }\n      g.add(m);\n    }\n  }\n  for (let i = 0; i < 24; i++) {\n    const a = i / 24 * Math.PI * 2;\n    const post = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.22, 1.25, 5), postMat);\n    post.position.set(Math.cos(a) * (h - 1.1), 0.62, Math.sin(a) * (h - 1.1));\n    post.castShadow = true;\n    g.add(post);\n  }\n\n  // cabanas: one box per lodging in the plan, warm roofs, darker doors\n  const boxes = u.boxes_xy || [];\n  if (boxes.length) {\n    const wallGeo = new THREE.CylinderGeometry(1.05, 1.15, 1.75, 7);\n    const roofGeo = new THREE.ConeGeometry(1.55, 0.95, 7);\n    const wallMat = new THREE.MeshStandardMaterial({ color: 0xd8cbaa, roughness: 0.95 });\n    const roofMat = new THREE.MeshStandardMaterial({ color: 0x9a7448, roughness: 0.9 });\n    const walls = new THREE.InstancedMesh(wallGeo, wallMat, boxes.length);\n    const roofs = new THREE.InstancedMesh(roofGeo, roofMat, boxes.length);\n    const doors = new THREE.InstancedMesh(\n      new THREE.PlaneGeometry(0.58, 1.08),\n      new THREE.MeshStandardMaterial({ color: 0x4a3826, roughness: 0.95,\n        side: THREE.DoubleSide }), boxes.length);\n    const windows = new THREE.InstancedMesh(\n      new THREE.PlaneGeometry(0.34, 0.34),\n      new THREE.MeshStandardMaterial({ color: 0x334446, roughness: 0.35,\n        metalness: 0.2, side: THREE.DoubleSide }), boxes.length * 2);\n    walls.castShadow = roofs.castShadow = true;\n    walls.receiveShadow = true;\n    const m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), v = new THREE.Vector3();\n    const col = new THREE.Color();\n    boxes.forEach(([x, y], i) => {\n      const cx = x - h, cz = y - h;\n      const dx = -cx, dz = -cz, d = Math.hypot(dx, dz) || 1;\n      q.setFromAxisAngle(new THREE.Vector3(0, 1, 0), Math.atan2(dx / d, dz / d));\n      v.set(cx, 0.9, cz);\n      m4.compose(v, q, new THREE.Vector3(1, 1, 1)); walls.setMatrixAt(i, m4);\n      v.set(cx, 2.18, cz);\n      m4.compose(v, q, new THREE.Vector3(1, 1, 1)); roofs.setMatrixAt(i, m4);\n      v.set(cx + dx / d * 1.14, 0.63, cz + dz / d * 1.14);\n      m4.compose(v, q, new THREE.Vector3(1, 1, 1)); doors.setMatrixAt(i, m4);\n      const tx = -dz / d, tz = dx / d;\n      [-0.62, 0.62].forEach((off, k) => {\n        v.set(cx + dx / d * 1.14 + tx * off, 1.02,\n              cz + dz / d * 1.14 + tz * off);\n        m4.compose(v, q, new THREE.Vector3(1, 1, 1));\n        windows.setMatrixAt(i * 2 + k, m4);\n      });\n      const occ = (u.box_occ && u.box_occ[String(i)]) || 0;\n      col.setHex(occ > 0 ? 0xb08050 : 0x8d6a42);\n      roofs.setColorAt(i, col);\n    });\n    walls.instanceMatrix.needsUpdate = true; roofs.instanceMatrix.needsUpdate = true;\n    doors.instanceMatrix.needsUpdate = true; windows.instanceMatrix.needsUpdate = true;\n    if (roofs.instanceColor) roofs.instanceColor.needsUpdate = true;\n    g.add(walls, roofs, doors, windows);\n    g.userData.roofs = roofs;\n  }\n\n  // the four hoppers: free food at the corners, each with a small bar\n  const hopperAt = [[8, 8], [S - 8, 8], [8, S - 8], [S - 8, S - 8]];\n  const metal = new THREE.MeshStandardMaterial({ color: 0x8a8f84, roughness: 0.45, metalness: 0.55 });\n  const counter = new THREE.MeshStandardMaterial({ color: 0x7a5a38, roughness: 0.85 });\n  const food = new THREE.MeshStandardMaterial({ color: 0xe4b456, emissive: 0x6a4410,\n    emissiveIntensity: 0.55, roughness: 0.5 });\n  hopperAt.forEach(([x, y]) => {\n    const cx = x - h, cz = y - h;\n    const base = new THREE.Mesh(new THREE.CylinderGeometry(0.62, 0.78, 1.0, 8), metal);\n    base.position.set(cx, 0.5, cz); base.castShadow = true; g.add(base);\n    const bowl = new THREE.Mesh(new THREE.CylinderGeometry(1.15, 0.75, 0.36, 12), food);\n    bowl.position.set(cx, 1.18, cz); g.add(bowl);\n    const canopy = new THREE.Mesh(new THREE.ConeGeometry(1.75, 0.65, 8), counter);\n    canopy.position.set(cx, 3.0, cz); canopy.castShadow = true; g.add(canopy);\n    for (let k = 0; k < 4; k++) {\n      const a = k * Math.PI / 2 + Math.PI / 4;\n      const post = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.065, 2.0, 4), metal);\n      post.position.set(cx + Math.cos(a) * 1.35, 2.0, cz + Math.sin(a) * 1.35);\n      g.add(post);\n    }\n    // the buffet counter every hopper carries\n    const bar = new THREE.Mesh(new THREE.BoxGeometry(2.7, 0.95, 0.75), counter);\n    const bx = cx + Math.sign(cx || 1) * 2.0, bz = cz + Math.sign(cz || 1) * 2.0;\n    bar.position.set(bx, 0.48, bz); bar.castShadow = true; g.add(bar);\n    for (let k = 0; k < 3; k++) {\n      const stool = new THREE.Mesh(new THREE.CylinderGeometry(0.26, 0.30, 0.45, 7), counter);\n      stool.position.set(bx - 0.8 + k * 0.8, 0.23, bz + 0.85);\n      g.add(stool);\n    }\n  });\n  // the light that says the pen is awake after dark\n  const lampMat = new THREE.MeshBasicMaterial({ color: 0xffd28a });\n  const lampGeo = new THREE.SphereGeometry(0.055, 5, 4);\n  const lamps = new THREE.InstancedMesh(lampGeo, lampMat, 28);\n  const m4 = new THREE.Matrix4(), v = new THREE.Vector3(), q = new THREE.Quaternion();\n  for (let i = 0; i < 28; i++) {\n    const a = i / 28 * Math.PI * 2;\n    v.set(Math.cos(a) * (S / 2 - 1.2), 1.3 + 0.5 * Math.sin(a * 3), Math.sin(a) * (S / 2 - 1.2));\n    q.identity(); m4.compose(v, q, new THREE.Vector3(1, 1, 1));\n    lamps.setMatrixAt(i, m4);\n  }\n  lamps.instanceMatrix.needsUpdate = true;\n  lamps.userData.night = true;\n  g.add(lamps);\n  lamps.visible = false;\n  g.userData.lamps = lamps;\n\n  // the hedonistic amenities the model builds when the pen is crowded and bored\n  const f = u.facilities || {};\n  if (f.pool > 0) buildPool(g, h, 24, 9.5, f.pool);\n  if (f.bar > 0) buildBar(g, h, S - 9, 24, f.bar);\n  if (f.theater > 0) buildTheater(g, h, 9, 24, f.theater);\n  if (f.field > 0) buildField(g, h, 24, S - 9, f.field);\n}\n\nfunction buildPool(g, h, x, y, lvl) {\n  const cx = x - h, cz = y - h;\n  const deck = new THREE.Mesh(new THREE.BoxGeometry(16, 0.16, 10),\n    new THREE.MeshStandardMaterial({ color: 0xe3d8bd, roughness: 0.9 }));\n  deck.position.set(cx, 0.08, cz); deck.receiveShadow = true; g.add(deck);\n  const water = new THREE.Mesh(new THREE.BoxGeometry(13, 0.12, 7),\n    new THREE.MeshStandardMaterial({ color: 0x4fa8b8, transparent: true, opacity: 0.9,\n      roughness: 0.12, metalness: 0.15 }));\n  water.position.set(cx, 0.18, cz); g.add(water);\n  const white = new THREE.MeshStandardMaterial({ color: 0xf2efe3, roughness: 0.8 });\n  for (let i = 0; i < 5; i++) {\n    const lounger = new THREE.Mesh(new THREE.BoxGeometry(0.65, 0.22, 1.7), white);\n    lounger.position.set(cx - 6.0 + i * 3.0, 0.26, cz + 5.4);\n    lounger.rotation.z = 0.18; g.add(lounger);\n  }\n  for (let i = 0; i < 3; i++) {\n    const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 2.3, 4), white);\n    pole.position.set(cx - 5 + i * 5, 1.15, cz + 4.2); g.add(pole);\n    const top = new THREE.Mesh(new THREE.ConeGeometry(1.3, 0.4, 8),\n      new THREE.MeshStandardMaterial({ color: 0xe8e0cc, roughness: 0.9, side: THREE.DoubleSide }));\n    top.position.set(cx - 5 + i * 5, 2.35, cz + 4.2); g.add(top);\n  }\n  if (lvl >= 0.5) {\n    const board = new THREE.Mesh(new THREE.BoxGeometry(3.0, 2.4, 0.12),\n      new THREE.MeshStandardMaterial({ color: 0x2f6f7e, roughness: 0.6 }));\n    board.position.set(cx + 7.0, 1.2, cz); board.rotation.y = -Math.PI / 2; g.add(board);\n    const sign = new THREE.Mesh(new THREE.BoxGeometry(0.6, 2.4, 0.12),\n      new THREE.MeshStandardMaterial({ color: 0x5a4632, roughness: 0.9 }));\n    sign.position.set(cx + 6.7, 1.2, cz - 1.6); g.add(sign);\n  }\n}\n\nfunction buildBar(g, h, x, y, lvl) {\n  const cx = x - h, cz = y - h;\n  const wood = new THREE.MeshStandardMaterial({ color: 0x5a3f24, roughness: 0.82 });\n  const top = new THREE.MeshStandardMaterial({ color: 0x8a6238, roughness: 0.7 });\n  const counter = new THREE.Mesh(new THREE.BoxGeometry(7, 1.05, 0.9), wood);\n  counter.position.set(cx, 0.52, cz); counter.castShadow = true; g.add(counter);\n  const lip = new THREE.Mesh(new THREE.BoxGeometry(7.3, 0.12, 1.15), top);\n  lip.position.set(cx, 1.1, cz); g.add(lip);\n  for (let i = 0; i < 5; i++) {\n    const stool = new THREE.Mesh(new THREE.CylinderGeometry(0.24, 0.28, 0.7, 7), wood);\n    stool.position.set(cx - 2.6 + i * 1.3, 0.35, cz + 1.3); g.add(stool);\n  }\n  // a canopy of woven thatch\n  for (let k = 0; k < 4; k++) {\n    const post = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.08, 3.1, 5), wood);\n    post.position.set(cx - 4 + (k % 2) * 8, 1.55, cz - 2 + Math.floor(k / 2) * 5);\n    post.castShadow = true; g.add(post);\n  }\n  const roof = new THREE.Mesh(new THREE.BoxGeometry(9.4, 0.18, 7.4),\n    new THREE.MeshStandardMaterial({ color: 0xa8894e, roughness: 0.95 }));\n  roof.position.set(cx, 3.15, cz + 0.5); roof.castShadow = true; g.add(roof);\n  if (lvl >= 0.5) {\n    const shelf = new THREE.Mesh(new THREE.BoxGeometry(6.6, 1.6, 0.35), wood);\n    shelf.position.set(cx, 0.8, cz - 0.9); g.add(shelf);\n  }\n}\n\nfunction buildTheater(g, h, x, y, lvl) {\n  const cx = x - h, cz = y - h;\n  const wood = new THREE.MeshStandardMaterial({ color: 0x4d3822, roughness: 0.9 });\n  const stage = new THREE.Mesh(new THREE.BoxGeometry(7, 0.8, 5), wood);\n  stage.position.set(cx - 2, 0.4, cz); stage.castShadow = true; g.add(stage);\n  const screen = new THREE.Mesh(new THREE.PlaneGeometry(6, 3.4),\n    new THREE.MeshStandardMaterial({ color: 0xd8d2bd, roughness: 0.9 }));\n  screen.position.set(cx - 5.2, 2.4, cz); screen.rotation.y = -Math.PI / 2; g.add(screen);\n  const seatMat = new THREE.MeshStandardMaterial({ color: 0x7a5a34, roughness: 0.9 });\n  const benchGeo = new THREE.BoxGeometry(1.6, 0.35, 0.5);\n  const benches = new THREE.InstancedMesh(benchGeo, seatMat, 18);\n  const m4 = new THREE.Matrix4(), v = new THREE.Vector3(), q = new THREE.Quaternion();\n  let n = 0;\n  for (let r = 0; r < 3; r++) for (let c = 0; c < 6; c++) {\n    v.set(cx + 1.5 + r * 1.4, 0.24, cz - 2.6 + c * 1.05);\n    q.identity(); m4.compose(v, q, new THREE.Vector3(1, 1, 1));\n    benches.setMatrixAt(n++, m4);\n  }\n  benches.instanceMatrix.needsUpdate = true; benches.castShadow = true; g.add(benches);\n}\n\nfunction buildField(g, h, x, y, lvl) {\n  const cx = x - h, cz = y - h;\n  const N = 256, c = document.createElement("canvas"); c.width = c.height = N;\n  const q = c.getContext("2d");\n  q.fillStyle = "#4f7a3a"; q.fillRect(0, 0, N, N);\n  q.strokeStyle = "#e8e4d2"; q.lineWidth = 4;\n  q.strokeRect(10, 10, N - 20, N - 20);\n  q.beginPath(); q.moveTo(N / 2, 10); q.lineTo(N / 2, N - 10); q.stroke();\n  q.beginPath(); q.arc(N / 2, N / 2, 34, 0, Math.PI * 2); q.stroke();\n  const tex = new THREE.CanvasTexture(c); tex.colorSpace = THREE.SRGBColorSpace;\n  const field = new THREE.Mesh(new THREE.PlaneGeometry(16, 9),\n    new THREE.MeshStandardMaterial({ map: tex, roughness: 1 }));\n  field.rotation.x = -Math.PI / 2; field.position.set(cx, 0.02, cz);\n  field.receiveShadow = true; g.add(field);\n  const postMat = new THREE.MeshStandardMaterial({ color: 0xe8e4d2, roughness: 0.8 });\n  [-1, 1].forEach((s) => {\n    const post = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 2.4, 5), postMat);\n    post.position.set(cx, 1.2, cz + s * 4.5); g.add(post);\n  });\n}\n\n// ---- LAGOON: the island, its water and its weather ---------------------------\nlet lagoonField = null;            // heights on the tile grid, for feet and rays\n\nfunction terrainHeights(T) {\n  const S = T.length;\n  const base = new Float32Array(S * S);\n  for (let y = 0; y < S; y++) for (let x = 0; x < S; x++) {\n    const v = T[y][x];\n    let h;\n    if (v === 2) h = -1.45;\n    else if (v === 3) h = 0.10;\n    else if (v === 4) h = 0.28;\n    else if (v === 1) h = 0.52;\n    else if (v === 5) {\n      const d1 = Math.hypot(x - 86, y - 112), d2 = Math.hypot(x - 95, y - 102);\n      h = 0.55 + 4.6 * Math.pow(Math.max(0, 1 - d1 / 18), 1.7)\n             + 3.2 * Math.pow(Math.max(0, 1 - d2 / 13), 1.7)\n             + 0.35 * hash(x * 3, y * 5);\n    } else h = 0.38 + 0.10 * hash(x, y);\n    base[y * S + x] = h;\n  }\n  const V = new Float32Array((S + 1) * (S + 1));\n  for (let j = 0; j <= S; j++) for (let i = 0; i <= S; i++) {\n    let sum = 0, n = 0;\n    for (let dy = -1; dy <= 0; dy++) for (let dx = -1; dx <= 0; dx++) {\n      const x = i + dx, y = j + dy;\n      if (x < 0 || y < 0 || x >= S || y >= S) continue;\n      sum += base[y * S + x]; n++;\n    }\n    V[j * (S + 1) + i] = n ? sum / n : 0;\n  }\n  return { S, V };\n}\n\nfunction surfaceY(key, x, y) {\n  if (key !== "lagoon" || !lagoonField) return 0.005;\n  const { S, V } = lagoonField;\n  const fx = clamp(x, 0, S - 0.001), fy = clamp(y, 0, S - 0.001);\n  const i = Math.floor(fx), j = Math.floor(fy);\n  const tx = fx - i, ty = fy - j;\n  const a = V[j * (S + 1) + i], b = V[j * (S + 1) + i + 1];\n  const c = V[(j + 1) * (S + 1) + i], d = V[(j + 1) * (S + 1) + i + 1];\n  return lerp(lerp(a, b, tx), lerp(c, d, tx), ty);\n}\n\nfunction tileColor(v, h, x, y) {\n  if (v === 2) return h < -1.2 ? 0x335b5a : 0x4c7268;\n  if (v === 3) return 0xd6c294;\n  if (v === 1) return 0x3f6236;\n  if (v === 4) return 0x8a7a3d;\n  if (v === 5) return h > 3.2 ? 0x8d8a78 : 0x7d8a58;\n  return 0x6d8a4b;\n}\n\nlet grainTex = null;\nfunction grainTexture() {\n  if (grainTex) return grainTex;\n  const N = 128, c = document.createElement("canvas"); c.width = c.height = N;\n  const g = c.getContext("2d");\n  g.fillStyle = "#ffffff"; g.fillRect(0, 0, N, N);\n  for (let i = 0; i < 9000; i++) {\n    const v = 210 + ((Math.random() * 46) | 0);\n    g.fillStyle = `rgb(${v},${v},${v})`;\n    g.globalAlpha = 0.25;\n    g.fillRect(Math.random() * N, Math.random() * N, 1.3, 1.3);\n  }\n  g.globalAlpha = 1;\n  grainTex = new THREE.CanvasTexture(c);\n  grainTex.wrapS = grainTex.wrapT = THREE.RepeatWrapping;\n  grainTex.colorSpace = THREE.SRGBColorSpace;\n  grainTex.anisotropy = 4;\n  return grainTex;\n}\n\nfunction buildLagoonInto(g, u) {\n  const T = worldInfo && worldInfo.terrain;\n  if (!u || !T) return;\n  const S = T.length;\n  const field = terrainHeights(T);\n  lagoonField = field;\n  g.userData.S = S;\n  g.userData.ground = 0;\n  const V = field.V;\n\n  // the land: per-vertex colour from the record\'s tiles, a grain over it\n  const pos = [], col = [], uv = [], idx = [];\n  const c = new THREE.Color();\n  for (let j = 0; j <= S; j++) for (let i = 0; i <= S; i++) {\n    pos.push(i - S / 2, V[j * (S + 1) + i], j - S / 2);\n    uv.push(i * 0.26, j * 0.26);\n    const tx = Math.min(S - 1, i), ty = Math.min(S - 1, j);\n    const v = T[ty][tx];\n    c.setHex(tileColor(v, V[j * (S + 1) + i], i, j));\n    const n = 0.90 + 0.20 * hash(i * 7 + 11, j * 13 + 5);\n    c.multiplyScalar(n);\n    col.push(c.r, c.g, c.b);\n  }\n  for (let j = 0; j < S; j++) for (let i = 0; i < S; i++) {\n    const a = j * (S + 1) + i, b = a + 1, d = a + S + 1, e = d + 1;\n    idx.push(a, d, b, b, d, e);\n  }\n  const geo = new THREE.BufferGeometry();\n  geo.setAttribute("position", new THREE.Float32BufferAttribute(pos, 3));\n  geo.setAttribute("color", new THREE.Float32BufferAttribute(col, 3));\n  geo.setAttribute("uv", new THREE.Float32BufferAttribute(uv, 2));\n  geo.setIndex(idx);\n  geo.computeVertexNormals();\n  const land = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({\n    vertexColors: true, map: grainTexture(), roughness: 1.0, metalness: 0 }));\n  land.receiveShadow = true;\n  g.add(land);\n  g.userData.land = land;\n\n  buildWater(g, T, V, S);\n  buildVegetation(g, T, V, S, u);\n  buildSettlements(g, T, V, S, u);\n  buildBeasts(g, V, u, S);\n}\n\nfunction buildWater(g, T, V, S) {\n  const pos = [], uv = [], idx = [];\n  for (let j = 0; j <= S; j++) for (let i = 0; i <= S; i++) {\n    pos.push(i - S / 2, 0.02, j - S / 2);\n    uv.push(i / S, j / S);\n  }\n  for (let j = 0; j < S; j++) for (let i = 0; i < S; i++) {\n    const a = j * (S + 1) + i, b = a + 1, d = a + S + 1, e = d + 1;\n    idx.push(a, d, b, b, d, e);\n  }\n  const geo = new THREE.BufferGeometry();\n  geo.setAttribute("position", new THREE.Float32BufferAttribute(pos, 3));\n  geo.setAttribute("uv", new THREE.Float32BufferAttribute(uv, 2));\n  geo.setIndex(idx);\n  geo.computeVertexNormals();\n  // height texture: R = (height + 2) / 8\n  const data = new Uint8Array(S * S);\n  for (let y = 0; y < S; y++) for (let x = 0; x < S; x++)\n    data[y * S + x] = clamp(Math.round((V[y * (S + 1) + x] + 2) / 8 * 255), 0, 255);\n  const tex = new THREE.DataTexture(data, S, S, THREE.RedFormat, THREE.UnsignedByteType);\n  tex.minFilter = tex.magFilter = THREE.LinearFilter;\n  tex.unpackAlignment = 1;\n  tex.needsUpdate = true;\n\n  const mat = new THREE.ShaderMaterial({\n    transparent: true, depthWrite: false, side: THREE.DoubleSide,\n    uniforms: {\n      uTime: { value: 0 }, uSize: { value: S }, uHeight: { value: tex },\n      uDeep: { value: new THREE.Color(0x24506a) },\n      uShallow: { value: new THREE.Color(0x6fa1ac) },\n      uSun: { value: new THREE.Color(0xfff1cf) },\n      uSunDir: { value: new THREE.Vector3(0.5, 0.8, 0.3).normalize() },\n      uNight: { value: 0 }\n    },\n    vertexShader: `\n      uniform float uTime, uSize;\n      varying vec3 vWorld; varying vec2 vUv;\n      void main(){\n        vUv = uv;\n        vec3 p = position;\n        p.y += sin(p.x * 0.42 + uTime * 1.25) * 0.045\n             + sin(p.z * 0.33 - uTime * 1.05) * 0.035\n             + sin((p.x + p.z) * 0.19 + uTime * 0.55) * 0.02;\n        vec4 w = modelMatrix * vec4(p, 1.0);\n        vWorld = w.xyz;\n        gl_Position = projectionMatrix * viewMatrix * w;\n      }`,\n    fragmentShader: `\n      uniform float uTime, uSize, uNight;\n      uniform sampler2D uHeight;\n      uniform vec3 uDeep, uShallow, uSun, uSunDir;\n      varying vec3 vWorld; varying vec2 vUv;\n      float h21(vec2 p){ p=fract(p*vec2(123.34,456.21)); p+=dot(p,p+45.32); return fract(p.x*p.y); }\n      void main(){\n        float land = texture2D(uHeight, vUv).r * 8.0 - 2.0;\n        if (land > 0.035) discard;\n        float depth = clamp((0.035 - land) / 6.0, 0.0, 1.0);\n        vec3 view = normalize(cameraPosition - vWorld);\n        vec3 n = normalize(vec3(\n          sin(vWorld.x * 0.9 + uTime * 1.6) * 0.055,\n          1.0,\n          sin(vWorld.z * 0.8 - uTime * 1.3) * 0.055));\n        float fres = pow(1.0 - clamp(dot(n, view), 0.0, 1.0), 3.0);\n        vec3 col = mix(uShallow, uDeep, smoothstep(0.05, 0.75, depth));\n        col = mix(col, uSun * 0.72, fres * 0.52);\n        vec3 refl = reflect(-normalize(uSunDir), n);\n        col += uSun * pow(max(dot(refl, view), 0.0), 90.0) * 0.85;\n        float band = smoothstep(0.55, 0.06, depth);\n        float foam = band * smoothstep(0.35, 0.85,\n          0.5 + 0.5 * sin(vWorld.x * 2.1 + vWorld.z * 1.7 + uTime * 2.2)\n          * sin(vWorld.z * 2.6 - uTime * 1.4));\n        col = mix(col, vec3(0.92, 0.94, 0.90), foam * 0.65);\n        col *= 1.0 - uNight * 0.45;\n        float alpha = mix(0.45, 0.95, smoothstep(0.0, 0.5, depth));\n        alpha = max(alpha, foam * 0.75);\n        gl_FragColor = vec4(col, alpha);\n      }`\n  });\n  const water = new THREE.Mesh(geo, mat);\n  water.renderOrder = 3;\n  water.userData.water = true;\n  g.add(water);\n  g.userData.water = water;\n}\n\n// ---- LAGOON: forest, palms, camp, and the animals the record carries ---------\nfunction buildVegetation(g, T, V, S, u) {\n  const clear = [];\n  (u.settlements || []).forEach((st) => clear.push([st.x, st.y, 7]));\n  (u.settlements || []).forEach((st) => (st.huts || []).forEach((h) =>\n    clear.push([h.x, h.y, 2.6])));\n  const blocked = (x, y) => clear.some(([cx, cy, r]) =>\n    Math.hypot(x - cx, y - cy) < r);\n\n  const broad = [], palms = [], bushes = [], rocks = [];\n  for (let y = 1; y < S - 1; y++) for (let x = 1; x < S - 1; x++) {\n    const v = T[y][x];\n    if (v === 2 || v === 4) continue;\n    if (blocked(x, y)) continue;\n    const r = hash(x * 17 + 3, y * 29 + 7);\n    const px = x + 0.25 + 0.5 * hash(x + 91, y + 3);\n    const py = y + 0.25 + 0.5 * hash(x + 7, y + 53);\n    const h = surfaceY("lagoon", px, py);\n    if (v === 1 && r < 0.44) broad.push([px, py, h, 0.75 + 0.7 * r]);\n    else if (v === 1 && r < 0.60) bushes.push([px, py, h, 0.7 + 0.6 * r]);\n    else if (v === 3 && r < 0.045) palms.push([px, py, h, 0.8 + 0.5 * r]);\n    else if (v === 0) {\n      if (r < 0.022) broad.push([px, py, h, 0.7 + 0.6 * r]);\n      else if (r < 0.052) palms.push([px, py, h, 0.75 + 0.6 * r]);\n      else if (r < 0.080) bushes.push([px, py, h, 0.55 + 0.5 * r]);\n    } else if (v === 5) {\n      if (r < 0.035) rocks.push([px, py, h, 0.7 + 0.9 * r]);\n      else if (r < 0.070) bushes.push([px, py, h, 0.5 + 0.5 * r]);\n    }\n    if (broad.length > 850 && palms.length > 200 && bushes.length > 700) break;\n  }\n  // broadleaf: a trunk and two canopy masses, the way a tropical crown reads\n  if (broad.length) {\n    const trunkGeo = new THREE.CylinderGeometry(0.16, 0.28, 1, 5); trunkGeo.translate(0, 0.5, 0);\n    const trunk = new THREE.InstancedMesh(trunkGeo,\n      new THREE.MeshStandardMaterial({ color: 0x5a4530, roughness: 1 }), broad.length);\n    const crownGeo = new THREE.IcosahedronGeometry(1, 1);\n    const crown = new THREE.InstancedMesh(crownGeo,\n      new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 1, flatShading: true }),\n      broad.length * 2);\n    const m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), v3 = new THREE.Vector3(), col = new THREE.Color();\n    broad.forEach(([px, py, h, s], i) => {\n      const H = 3.4 * s;\n      q.setFromAxisAngle(new THREE.Vector3(0, 1, 0), hash(px, py) * 6.28);\n      m4.compose(v3.set(px - S / 2, h, py - S / 2), q, new THREE.Vector3(s, H, s));\n      trunk.setMatrixAt(i, m4);\n      const c1 = 0.72 + 0.22 * hash(px + 3, py + 8);\n      col.setRGB(0.18 * c1, 0.36 * c1, 0.15 * c1); crown.setColorAt(i * 2, col);\n      col.setRGB(0.15 * c1, 0.30 * c1, 0.13 * c1); crown.setColorAt(i * 2 + 1, col);\n      for (let k = 0; k < 2; k++) {\n        const rr = (k ? 0.75 : 1.0) * (1.25 + 0.45 * hash(px + k, py));\n        q.identity();\n        m4.compose(v3.set(px - S / 2 + (k ? 0.5 : -0.2) * s,\n                         h + H * 0.92 + (k ? 0.7 : 0) * s,\n                         py - S / 2 + (k ? -0.3 : 0.2) * s),\n                   q, new THREE.Vector3(rr, rr * 0.9, rr));\n        crown.setMatrixAt(i * 2 + k, m4);\n      }\n    });\n    trunk.instanceMatrix.needsUpdate = true; crown.instanceMatrix.needsUpdate = true;\n    if (crown.instanceColor) crown.instanceColor.needsUpdate = true;\n    trunk.castShadow = crown.castShadow = true; trunk.receiveShadow = true;\n    g.add(trunk, crown);\n  }\n  // palms lean out over the shore\n  if (palms.length) {\n    const trunkGeo = new THREE.CylinderGeometry(0.10, 0.22, 1, 5); trunkGeo.translate(0, 0.5, 0);\n    const trunk = new THREE.InstancedMesh(trunkGeo,\n      new THREE.MeshStandardMaterial({ color: 0x6b5236, roughness: 1 }), palms.length);\n    const frondGeo = new THREE.ConeGeometry(0.34, 2.0, 3); frondGeo.translate(0, 1.0, 0);\n    const fronds = new THREE.InstancedMesh(frondGeo,\n      new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 1, flatShading: true }),\n      palms.length * 6);\n    const m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), v3 = new THREE.Vector3(),\n      col = new THREE.Color(), up = new THREE.Vector3(0, 1, 0), dir = new THREE.Vector3();\n    palms.forEach(([px, py, h, s], i) => {\n      const H = 5.2 * s;\n      q.setFromAxisAngle(up, hash(px + 1, py + 2) * 6.28);\n      m4.compose(v3.set(px - S / 2, h, py - S / 2), q, new THREE.Vector3(s, H, s));\n      trunk.setMatrixAt(i, m4);\n      for (let k = 0; k < 6; k++) {\n        const a = k / 6 * Math.PI * 2 + 0.3;\n        dir.set(Math.cos(a) * 0.88, -0.30 - 0.12 * hash(k, i), Math.sin(a) * 0.88).normalize();\n        q.setFromUnitVectors(up, dir);\n        m4.compose(v3.set(px - S / 2 + Math.cos(a) * 0.2, h + H * 0.98,\n                          py - S / 2 + Math.sin(a) * 0.2),\n                   q, new THREE.Vector3(s, s, s));\n        fronds.setMatrixAt(i * 6 + k, m4);\n        const c = 0.75 + 0.2 * hash(a, i);\n        col.setRGB(0.19 * c, 0.40 * c, 0.17 * c);\n        fronds.setColorAt(i * 6 + k, col);\n      }\n    });\n    trunk.instanceMatrix.needsUpdate = true; fronds.instanceMatrix.needsUpdate = true;\n    if (fronds.instanceColor) fronds.instanceColor.needsUpdate = true;\n    trunk.castShadow = fronds.castShadow = true;\n    g.add(trunk, fronds);\n  }\n  if (bushes.length) {\n    const geo = new THREE.IcosahedronGeometry(0.55, 0);\n    const mesh = new THREE.InstancedMesh(geo,\n      new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 1, flatShading: true }),\n      bushes.length);\n    const m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), v3 = new THREE.Vector3(), col = new THREE.Color();\n    bushes.forEach(([px, py, h, s], i) => {\n      q.setFromAxisAngle(new THREE.Vector3(0, 1, 0), hash(px, py) * 6.28);\n      m4.compose(v3.set(px - S / 2, h + 0.22 * s, py - S / 2), q,\n                 new THREE.Vector3(s, s * 0.7, s));\n      mesh.setMatrixAt(i, m4);\n      const c = 0.65 + 0.3 * hash(px + 5, py + 1);\n      col.setRGB(0.22 * c, 0.40 * c, 0.17 * c); mesh.setColorAt(i, col);\n    });\n    mesh.instanceMatrix.needsUpdate = true;\n    if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;\n    mesh.castShadow = true; g.add(mesh);\n  }\n  if (rocks.length) {\n    const geo = new THREE.DodecahedronGeometry(0.6, 0);\n    const mesh = new THREE.InstancedMesh(geo,\n      new THREE.MeshStandardMaterial({ color: 0x8d8a78, roughness: 1, flatShading: true }),\n      rocks.length);\n    const m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), v3 = new THREE.Vector3();\n    rocks.forEach(([px, py, h, s], i) => {\n      q.setFromAxisAngle(new THREE.Vector3(0.3, 1, 0.1).normalize(), hash(px, py) * 6.28);\n      m4.compose(v3.set(px - S / 2, h + 0.15 * s, py - S / 2), q,\n                 new THREE.Vector3(s, s * 0.75, s));\n      mesh.setMatrixAt(i, m4);\n    });\n    mesh.instanceMatrix.needsUpdate = true;\n    mesh.castShadow = true; g.add(mesh);\n  }\n}\n\nfunction buildSettlements(g, T, V, S, u) {\n  const camps = u.settlements || [];\n  const state = u.camp_state || [];\n  g.userData.fires = [];\n  const wallMat = new THREE.MeshStandardMaterial({ color: 0x9a7a50, roughness: 1 });\n  const roofMat = new THREE.MeshStandardMaterial({ color: 0xa8894e, roughness: 1 });\n  const huts = [];\n  camps.forEach((st) => (st.huts || []).forEach((h) => {\n    if (h.done === false || (h.done === undefined && (h.w || 0) < 10)) return;\n    huts.push(h);\n  }));\n  if (huts.length) {\n    const wallGeo = new THREE.CylinderGeometry(1.05, 1.2, 1.9, 7); wallGeo.translate(0, 0.95, 0);\n    const roofGeo = new THREE.ConeGeometry(1.6, 1.0, 7); roofGeo.translate(0, 0.5, 0);\n    const walls = new THREE.InstancedMesh(wallGeo, wallMat, huts.length);\n    const roofs = new THREE.InstancedMesh(roofGeo, roofMat, huts.length);\n    const doors = new THREE.InstancedMesh(\n      new THREE.PlaneGeometry(0.55, 1.18),\n      new THREE.MeshStandardMaterial({ color: 0x352417, roughness: 1,\n        side: THREE.DoubleSide }), huts.length);\n    const m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), v3 = new THREE.Vector3();\n    huts.forEach((h, i) => {\n      const hx = h.x - S / 2, hz = h.y - S / 2, hy = surfaceY("lagoon", h.x, h.y);\n      q.setFromAxisAngle(new THREE.Vector3(0, 1, 0), hash(h.x, h.y) * 6.28);\n      m4.compose(v3.set(hx, hy, hz), q, new THREE.Vector3(1, 1, 1));\n      walls.setMatrixAt(i, m4);\n      m4.compose(v3.set(hx, hy + 1.9, hz), q, new THREE.Vector3(1, 1, 1));\n      roofs.setMatrixAt(i, m4);\n      let best = camps[0], bd = 1e9;\n      camps.forEach((st) => {\n        const d = Math.hypot(st.x - h.x, st.y - h.y);\n        if (d < bd) { bd = d; best = st; }\n      });\n      const dx = best.x - h.x, dz = best.y - h.y, d = Math.hypot(dx, dz) || 1;\n      q.setFromAxisAngle(new THREE.Vector3(0, 1, 0), Math.atan2(dx / d, dz / d));\n      v3.set(hx + dx / d * 1.17, hy + 0.59, hz + dz / d * 1.17);\n      m4.compose(v3, q, new THREE.Vector3(1, 1, 1));\n      doors.setMatrixAt(i, m4);\n    });\n    walls.instanceMatrix.needsUpdate = true; roofs.instanceMatrix.needsUpdate = true;\n    doors.instanceMatrix.needsUpdate = true;\n    walls.castShadow = roofs.castShadow = true; walls.receiveShadow = true;\n    g.add(walls, roofs, doors);\n  }\n  const logMat = new THREE.MeshStandardMaterial({ color: 0x5a4530, roughness: 1 });\n  const glowMat = new THREE.MeshBasicMaterial({ color: 0xffae5a });\n  camps.forEach((st, ci) => {\n    const cs = state[ci] || {};\n    const cx = st.x - S / 2, cz = st.y - S / 2, cy = surfaceY("lagoon", st.x, st.y);\n    // the worn ground of a camp: many feet, no grass\n    const worn = new THREE.Mesh(new THREE.CircleGeometry(Math.min(7, st.r || 5), 24),\n      new THREE.MeshBasicMaterial({ color: 0x6b5a3c, transparent: true, opacity: 0.28 }));\n    worn.rotation.x = -Math.PI / 2; worn.position.set(cx, cy + 0.03, cz);\n    g.add(worn);\n    for (let k = 0; k < 5; k++) {\n      const log = new THREE.Mesh(new THREE.CylinderGeometry(0.11, 0.13, 1.2, 5), logMat);\n      const a = k / 5 * Math.PI * 2;\n      log.rotation.z = Math.PI / 2; log.rotation.y = a;\n      log.position.set(cx + Math.cos(a) * 0.55, cy + 0.14, cz + Math.sin(a) * 0.55);\n      g.add(log);\n    }\n    if (cs.fire) {\n      const flame = new THREE.Mesh(new THREE.ConeGeometry(0.32, 1.15, 6), glowMat);\n      flame.position.set(cx, cy + 0.62, cz); flame.userData.flame = true;\n      g.add(flame);\n      if (ci < 2) {\n        const light = new THREE.PointLight(0xff9a4a, 5.5, 13, 2);\n        light.position.set(cx, cy + 1.0, cz); light.userData.fire = true;\n        g.add(light);\n        g.userData.fires.push(light);\n      }\n    }\n    if (cs.granary) {\n      const base = new THREE.Mesh(new THREE.BoxGeometry(2.2, 0.25, 1.6), logMat);\n      base.position.set(cx + 3, cy + 0.9, cz - 2); g.add(base);\n      const basket = new THREE.Mesh(new THREE.CylinderGeometry(0.8, 0.55, 1.1, 8),\n        new THREE.MeshStandardMaterial({ color: 0xb59a68, roughness: 1 }));\n      basket.position.set(cx + 3, cy + 1.55, cz - 2); g.add(basket);\n      for (let k = 0; k < 4; k++) {\n        const leg = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.06, 0.9, 4), logMat);\n        leg.position.set(cx + 3 + (k % 2 ? 0.8 : -0.8), cy + 0.45, cz - 2 + (k < 2 ? 0.6 : -0.6));\n        g.add(leg);\n      }\n    }\n    if (cs.writing) {\n      const stone = new THREE.Mesh(new THREE.BoxGeometry(0.7, 2.0, 0.22),\n        new THREE.MeshStandardMaterial({ color: 0x8a8778, roughness: 1 }));\n      stone.position.set(cx - 3, cy + 1.0, cz + 2); stone.rotation.y = 0.35;\n      stone.castShadow = true; g.add(stone);\n    }\n  });\n  // boats: a hull drawn where the record has one\n  (u.boats || []).forEach((b) => {\n    if (!b) return;\n    const x = Array.isArray(b) ? b[0] : (b.x !== undefined ? b.x : null);\n    const y = Array.isArray(b) ? b[1] : (b.y !== undefined ? b.y : null);\n    if (x === null || y === null) return;\n    const hull = new THREE.Mesh(new THREE.SphereGeometry(1, 7, 4),\n      new THREE.MeshStandardMaterial({ color: 0x5a4530, roughness: 1 }));\n    hull.scale.set(2.6, 0.32, 0.55);\n    hull.position.set(x - S / 2, 0.18, y - S / 2);\n    g.add(hull);\n  });\n  // farms: a plot with rows, if the record has broken ground\n  (u.farms || []).forEach((f) => {\n    const x = f.x, y = f.y;\n    if (x === undefined || y === undefined) return;\n    const plot = new THREE.Mesh(new THREE.PlaneGeometry(6, 4),\n      new THREE.MeshStandardMaterial({ color: 0x7a6338, roughness: 1 }));\n    plot.rotation.x = -Math.PI / 2;\n    plot.position.set(x - S / 2, surfaceY("lagoon", x, y) + 0.04, y - S / 2);\n    g.add(plot);\n  });\n}\n\nfunction buildBeasts(g, V, u, S) {\n  const rows = u.animals || [];\n  if (!rows.length) return;\n  const cap = Math.max(rows.length + 128, 640);\n  const bodyGeo = new THREE.CapsuleGeometry(0.5, 1.0, 3, 6);\n  bodyGeo.rotateX(Math.PI / 2);\n  const headGeo = new THREE.SphereGeometry(0.5, 6, 5);\n  const legGeo = new THREE.CylinderGeometry(0.5, 0.5, 1, 4);\n  const body = new THREE.InstancedMesh(bodyGeo,\n    new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 1 }), cap);\n  const head = new THREE.InstancedMesh(headGeo,\n    new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 1 }), cap);\n  const legs = new THREE.InstancedMesh(legGeo,\n    new THREE.MeshStandardMaterial({ color: 0x5a4530, roughness: 1 }), cap * 4);\n  [body, head, legs].forEach((m) => {\n    m.instanceMatrix.setUsage(THREE.DynamicDrawUsage);\n    m.frustumCulled = false;\n  });\n  body.castShadow = head.castShadow = true;\n  g.add(body, head, legs);\n  g.userData.beasts = { body, head, legs, rows: [], S };\n  updateBeasts(g, u);\n}\n\nfunction placeBeast(b, i, r, S) {\n  const x = r[0], y = r[1], kind = r[2];\n  const deer = kind === "deer";\n  const hy = surfaceY("lagoon", x, y);\n  const sc = deer ? 1.0 : 0.55;\n  const yaw = hash(x + i, y + i) * 6.28;\n  const m4 = _m, q = _q, v3 = _v, col = _col;\n  q.setFromAxisAngle(_up, yaw);\n  m4.compose(v3.set(x - S / 2, hy + 0.62 * sc, y - S / 2), q,\n             _s.set(sc, sc, sc));\n  b.body.setMatrixAt(i, m4);\n  col.setHex(deer ? 0x8a6a44 : 0xa08050); b.body.setColorAt(i, col);\n  m4.compose(v3.set(x - S / 2 + Math.cos(yaw) * 0.82 * sc,\n                    hy + 0.92 * sc, y - S / 2 + Math.sin(yaw) * 0.82 * sc),\n             q, _s.set(sc * 0.55, sc * 0.55, sc * 0.55));\n  b.head.setMatrixAt(i, m4); b.head.setColorAt(i, col);\n  for (let k = 0; k < 4; k++) {\n    const lx = (k % 2 ? 0.28 : -0.28) * sc, lz = (k < 2 ? 0.45 : -0.45) * sc;\n    q.identity();\n    m4.compose(v3.set(x - S / 2 + lx, hy + 0.28 * sc, y - S / 2 + lz), q,\n               _s.set(sc * 0.11, 0.56 * sc, sc * 0.11));\n    b.legs.setMatrixAt(i * 4 + k, m4);\n  }\n}\n\nfunction updateBeasts(g, u) {\n  const b = g.userData.beasts;\n  if (!b) return;\n  const rows = (u && u.animals) || [];\n  const n = Math.min(rows.length, b.body.instanceMatrix.count);\n  for (let i = 0; i < n; i++) placeBeast(b, i, rows[i], b.S);\n  b.body.count = b.head.count = n;\n  b.legs.count = n * 4;\n  b.body.instanceMatrix.needsUpdate = true;\n  b.head.instanceMatrix.needsUpdate = true;\n  b.legs.instanceMatrix.needsUpdate = true;\n  if (b.body.instanceColor) b.body.instanceColor.needsUpdate = true;\n  if (b.head.instanceColor) b.head.instanceColor.needsUpdate = true;\n}\n\n// ---- the people: one instanced body per person, driven by the record ----------\nconst PEOPLE = {};\nconst STATURE = [0.30, 0.46, 0.56, 0.67, 0.78, 0.87, 0.96, 1.0, 0.97];\nconst AGE_BAND = [0, 1.5, 3, 6, 9, 12, 15, 18, 60];\nconst A = { WALK: 1, FORAGE: 2, HUNT: 3, FISH: 4, FARM: 5, BUILD: 6, TALK: 7,\n  MATE: 8, BIRTH: 9, TEND: 10, REST: 11, EAT: 12, WITHDRAW: 13, FIGHT: 14,\n  PLAY: 15, RITE: 16, SLEEP: 17, WORK: 18, SCOUT: 19, WATCH: 20, GROOM: 21, DRINK: 22 };\n\nfunction ageBand(age) {\n  for (let i = AGE_BAND.length - 1; i > 0; i--) if (age >= AGE_BAND[i]) return i;\n  return 0;\n}\nfunction stature(age) { return STATURE[ageBand(age)]; }\n\nconst _m = new THREE.Matrix4(), _q = new THREE.Quaternion(), _q2 = new THREE.Quaternion(), _v = new THREE.Vector3();\nconst _a = new THREE.Vector3(), _b = new THREE.Vector3(), _mid = new THREE.Vector3();\nconst _dir = new THREE.Vector3(), _s = new THREE.Vector3(), _col = new THREE.Color();\nconst _up = new THREE.Vector3(0, 1, 0);\n\nfunction inst(geo, cap, opts) {\n  const m = new THREE.InstancedMesh(geo,\n    new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.94, metalness: 0,\n      ...(opts || {}) }), cap);\n  m.instanceMatrix.setUsage(THREE.DynamicDrawUsage);\n  m.frustumCulled = false;\n  m.count = 0;\n  return m;\n}\n\nclass Crowd {