   [this.head, this.hair, this.torso, this.arms, this.legs, this.hands,\n     this.feet, this.trunks].forEach((m) => {\n      if (m.instanceMatrix) m.instanceMatrix.needsUpdate = true;\n      if (m.instanceColor) m.instanceColor.needsUpdate = true;\n    });\n    this.shadow.instanceMatrix.needsUpdate = true;\n    this.head.count = c.n; this.hair.count = c.nhair; this.torso.count = c.n;\n    this.arms.count = c.na; this.legs.count = c.nl;\n    this.hands.count = c.nh; this.feet.count = c.nf;\n    this.trunks.count = c.nt; this.shadow.count = c.ns;\n  }\n\n  drawBody(a, root, t, big, fast, c) {\n    const key = this.key;\n    const H = 1.72 * stature(a.age) * (a.sex ? 0.93 : 1.0);\n    const fat = clamp((a.bmi || 22) / 22, 0.78, 1.55);\n    const strong = clamp((a.sn || 5) / 10, 0.2, 1.0);\n    const lying = a.act === A.SLEEP || a.act === A.MATE || a.act === A.BIRTH ||\n                  a.age < 1;\n    const sitting = a.act === A.REST || a.act === A.EAT || a.act === A.GROOM ||\n                    a.act === A.WORK || a.act === A.TEND;\n    const yawQ = new THREE.Quaternion().setFromAxisAngle(_up, a.yaw);\n    let bodyQ = yawQ.clone();\n    if (lying) {\n      const qx = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1, 0, 0), Math.PI / 2);\n      bodyQ = yawQ.clone().multiply(qx);\n    }\n    const shHalf = (a.sex ? 0.101 : 0.118) * H * Math.sqrt(fat) * (1 + 0.05 * strong);\n    const hipHalf = (a.sex ? 0.099 : 0.091) * H * Math.sqrt(fat);\n    const torsoR = (a.sex ? 0.093 : 0.101) * H * Math.sqrt(fat) * (1 + 0.06 * strong);\n    const limbR = 0.030 * H * (0.82 + 0.30 * strong);\n    const headR = H / 15.2 * (a.age < 15 ? 1.16 : 1.0);\n    const skin = PAL.skin[a.id % 4];\n    const hairC = a.age >= 60 ? 0xd9d9d9 : PAL.hair[(a.id * 3) % 5];\n    const cloth = key === "eden"\n      ? (a.sex ? PAL.swim[a.id % PAL.swim.length] : skin)\n      : (this.u.harsh ? PAL.fur : PAL.hide);\n    const legCloth = key === "eden" ? skin : cloth;\n\n    // local points: x right, y up, z forward; the body quaternion maps them\n    let hipY, shY, headY;\n    if (lying) { hipY = 0.24; shY = 0.86; headY = 1.03; }\n    else if (sitting) { hipY = 0.45; shY = 0.91; headY = 1.04; }\n    else { hipY = 0.52 * H; shY = 0.82 * H; headY = 0.935 * H; }\n    const rootLift = lying ? 0.13 * big : 0;\n    const base = root;\n    const P = (x, y, z) => new THREE.Vector3(x * big, y * big, z * big)\n      .applyQuaternion(bodyQ).add(base).add(_v.set(0, rootLift, 0));\n    const swing = Math.sin(t * (fast ? 9.0 : 5.2) + a.phase) * (0.085 * H);\n    let hipC, shC, headC;\n    if (lying) {\n      hipC = P(0, 0.0, 0);\n      shC = P(0, 0.62, 0);\n      headC = P(0, 0.82, 0);\n    } else if (sitting) {\n      hipC = P(0, hipY, 0);\n      shC = P(0, shY, 0.02);\n      headC = P(0, headY, 0.03);\n    } else {\n      hipC = P(0, hipY, 0);\n      shC = P(0, shY, 0);\n      headC = P(0, headY, 0);\n    }\n    // torso\n    seg(this.torso, c.n, hipC, shC, torsoR * big, cloth);\n    // head and hair\n    ball(this.head, c.n, headC, headR * big, skin);\n    if (a.age >= 3 && hash(a.id, 2) < 0.88) {\n      const back = lying ? P(0, 0.74, -0.04) : P(0, headY + 0.015, -0.025);\n      ball(this.hair, c.nhair++, back, headR * 1.03 * big, hairC);\n    }\n    // trunks (EDEN): a short brief over the pelvis\n    if (key === "eden") {\n      const cp = lying ? P(0, 0.02, -0.01) : P(0, hipY - 0.03, 0);\n      _q2.identity();\n      _m.compose(cp, bodyQ, _s.set(hipHalf * 1.5 * big, 0.10 * H * big, hipHalf * 1.15 * big));\n      this.trunks.setMatrixAt(c.nt, _m);\n      this.trunks.setColorAt(c.nt, _col.setHex(PAL.swim[a.id % 5]));\n      c.nt++;\n    }\n    // arms: shoulder -> elbow -> hand\n    const armUp = a.act === A.HUNT || a.act === A.FIGHT || a.act === A.RITE ||\n                  a.act === A.PLAY || a.act === A.WATCH;\n    for (let side = -1; side <= 1; side += 2) {\n      const sx = side * shHalf * 0.94;\n      let ex, ey, ez, hx, hy, hz;\n      if (lying) {\n        ex = side * shHalf * 1.05; ey = 0.50; ez = -0.01;\n        hx = side * shHalf * 1.10; hy = 0.06; hz = -0.01;\n      } else if (sitting) {\n        ex = side * shHalf * 1.18; ey = shY - 0.16 * H; ez = 0.16;\n        hx = side * shHalf * 1.22; hy = shY - 0.30 * H; hz = 0.34;\n      } else if (armUp) {\n        ex = side * (shHalf + 0.06 * H); ey = shY - 0.02 * H; ez = 0.16 * H;\n        hx = side * (shHalf + 0.10 * H); hy = shY + 0.10 * H; hz = 0.30 * H;\n      } else {\n        const sw = swing * side;\n        ex = side * (shHalf + 0.015 * H); ey = shY - 0.16 * H; ez = sw;\n        hx = side * (shHalf + 0.025 * H); hy = shY - 0.31 * H; hz = sw * 1.5;\n      }\n      const shp = P(sx, shY, 0), el = P(ex, ey, ez), hd = P(hx, hy, hz);\n      seg(this.arms, c.na++, shp, el, limbR * 0.92 * big, skin);\n      seg(this.arms, c.na++, el, hd, limbR * 0.78 * big, skin);\n      ball(this.hands, c.nh, hd, limbR * 0.95 * big, skin);\n      c.nh++;\n    }\n    // legs: hip -> knee -> ankle, planted or swinging\n    for (let side = -1; side <= 1; side += 2) {\n      const hx = side * hipHalf * 0.92;\n      let kx = hx, ky, kz, ax = hx, ay, az;\n      if (lying) {\n        ky = -0.42; kz = 0.0; ay = -0.80; az = 0.0;\n      } else if (sitting) {\n        ky = 0.47; kz = 0.40; ay = 0.09; az = 0.52;\n      } else {\n        const sw = swing * side * 1.5;\n        ky = hipY - 0.24 * H; kz = sw;\n        ay = 0.055; az = sw * 1.65;\n        if (a.act === A.HUNT) { ky = hipY - 0.22 * H; kz = 0.10 * H; ay = 0.06; az = 0.18 * H; }\n      }\n      const hp = P(hx, hipY, 0), kn = P(kx, ky, kz), an = P(ax, ay, az);\n      seg(this.legs, c.nl++, hp, kn, limbR * 1.18 * big, legCloth);\n      seg(this.legs, c.nl++, kn, an, limbR * 1.02 * big, legCloth);\n      const foot = P(ax, ay, az + (lying ? 0.0 : 0.10));\n      ball(this.feet, c.nf++, foot, limbR * 0.92 * big, skin);\n    }\n  }\n}\n\nfunction seg(mesh, i, a, b, r, color) {\n  _dir.subVectors(b, a);\n  const len = _dir.length() || 1e-4;\n  _q.setFromUnitVectors(_up, _dir.normalize());\n  _mid.addVectors(a, b).multiplyScalar(0.5);\n  _m.compose(_mid, _q, _s.set(Math.max(0.008, r * 2), Math.max(0.004, len / 2), Math.max(0.008, r * 2)));\n  mesh.setMatrixAt(i, _m);\n  mesh.setColorAt(i, _col.setHex(color));\n}\n\nfunction ball(mesh, i, p, r, color) {\n  _q.identity();\n  _m.compose(p, _q, _s.set(r * 2, r * 2, r * 2));\n  mesh.setMatrixAt(i, _m);\n  mesh.setColorAt(i, _col.setHex(color));\n}\n\n// ---- what the record says, as text -----------------------------------------\nfunction esc(s) {\n  return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;")\n    .replace(/>/g, "&gt;");\n}\nfunction facLine(u) {\n  const f = (u && u.facilities) || {};\n  const pct = (v) => Math.round(clamp(+v || 0, 0, 1) * 100) + "%";\n  return "POOL " + pct(f.pool) + " · BAR " + pct(f.bar) +\n         " · THEATER " + pct(f.theater) + " · FIELD " + pct(f.field);\n}\nfunction worldLines(key, u) {\n  if (!u) return ["—", "waiting for the record"];\n  const head = (key === "eden" ? "EDEN · U6" : "LAGOON · U9");\n  if (key === "eden") {\n    const built = facLine(u);\n    return [head,\n      "Y" + u.year + " · " + String(u.tod || "").toUpperCase() +\n        " · POP " + u.pop + " · ITER " + u.iter,\n      String(u.phase || "").toUpperCase() + " · ALWAYS SPRING · " +\n        ((u.gauges && u.gauges.breeders) || 0) + " BREEDERS",\n      built,\n      ((u.homeless || 0) > 0 ? u.homeless + " PLACELESS · " : "") +\n        ((u.roles && u.roles[1]) ? "POSTS " + u.roles[0] + "/" + u.roles[1] : "THE PEN IS OPEN")];\n  }\n  const camps = (u.settlements || []).length;\n  let huts = 0;\n  (u.settlements || []).forEach((s) => { huts += (s.huts || []).length; });\n  const lessons = (u.lessons && u.lessons.length)\n    ? "INSTINCTS " + u.lessons.join(", ").toUpperCase() : "NO INHERITED INSTINCTS";\n  return [head,\n    "Y" + u.year + " · " + String(u.tod || "").toUpperCase() +\n      " · POP " + u.pop + " · ITER " + u.iter,\n    String(u.season || "").toUpperCase() + " · " + String(u.phase || "").toUpperCase() +\n      " · " + camps + " CAMP" + (camps === 1 ? "" : "S"),\n    huts + " HUTS · " + ((u.animals || []).length) + " ANIMALS · " +\n      ((u.boats || []).length) + " BOATS · " + ((u.farms || []).length) + " FARMS",\n    lessons];\n}\n\n// ---- labels: the record, set above each diorama -----------------------------\nfunction labelLines(key, u) {\n  if (!u) return ["—", "waiting for the record"];\n  const head = key === "eden" ? "EDEN · U6" : "LAGOON · U9";\n  const at = "Y" + u.year + " · " + String(u.tod || "").toUpperCase() + " · POP " + u.pop;\n  if (key === "eden") {\n    const f = u.facilities || {};\n    const pct = (v) => Math.round(clamp(+v || 0, 0, 1) * 100) + "%";\n    return [head, at,\n      "POOL " + pct(f.pool) + " · BAR " + pct(f.bar) + " · THEATER " + pct(f.theater),\n      String(u.phase || "").toUpperCase() + " · " +\n        ((u.gauges && u.gauges.breeders) || 0) + " BREEDERS"];\n  }\n  const camps = (u.settlements || []).length;\n  let huts = 0;\n  (u.settlements || []).forEach((s) => { huts += (s.huts || []).length; });\n  const lessons = (u.lessons && u.lessons.length)\n    ? "INSTINCTS " + u.lessons.join(", ").toUpperCase()\n    : String(u.tech && u.tech.length ? u.tech[u.tech.length - 1] : u.phase || "").toUpperCase();\n  return [head, at,\n    String(u.season || "").toUpperCase() + " · " + camps + " CAMP" +\n      (camps === 1 ? "" : "S") + " · " + huts + " HUTS",\n    lessons];\n}\n\nfunction makeLabel(w, h) {\n  const c = document.createElement("canvas");\n  c.width = w; c.height = h;\n  const tex = new THREE.CanvasTexture(c);\n  tex.colorSpace = THREE.SRGBColorSpace;\n  tex.minFilter = THREE.LinearFilter;\n  tex.anisotropy = 4;\n  const mat = new THREE.SpriteMaterial({ map: tex, transparent: true,\n    depthWrite: false, toneMapped: false });\n  const sprite = new THREE.Sprite(mat);\n  sprite.scale.set(1.34, 0.447, 1);\n  return { canvas: c, ctx: c.getContext("2d"), tex, sprite, sig: "" };\n}\n\nfunction paintLabel(L, key, u) {\n  const lines = labelLines(key, u);\n  const sig = lines.join("\\n");\n  if (sig === L.sig) return;\n  L.sig = sig;\n  const c = L.canvas, g = L.ctx, W = c.width, H = c.height;\n  g.clearRect(0, 0, W, H);\n  g.fillStyle = "rgba(20,19,15,0.88)";\n  g.fillRect(0, 0, W, H);\n  g.strokeStyle = "#37332a"; g.lineWidth = 2;\n  g.strokeRect(1, 1, W - 2, H - 2);\n  g.fillStyle = key === "eden" ? "#8ec5d6" : "#a6c98a";\n  g.fillRect(0, 0, 8, H);\n  g.textBaseline = "middle";\n  const fit = (txt, size, weight, keep) => {\n    g.font = weight + " " + size + \'px system-ui, -apple-system, sans-serif\';\n    let s = txt;\n    if (g.measureText(s).width > W - 44) {\n      while (s.length > 4 && g.measureText(s + "…").width > W - 44) s = s.slice(0, -1);\n      s += "…";\n    }\n    g.fillStyle = keep;\n    g.fillText(s, 28, 0);\n  };\n  const ys = [44, 102, 158, 212];\n  const sizes = [44, 34, 30, 28];\n  for (let i = 0; i < lines.length && i < 4; i++) {\n    g.save();\n    g.translate(0, ys[i]);\n    fit(lines[i], sizes[i], i === 0 ? "600" : "400",\n        i === 0 ? "#ede6d6" : (i === 3 && key === "lagoon" ? "#a6c98a" : "#a39b88"));\n    g.restore();\n  }\n  L.tex.needsUpdate = true;\n}\n\nfunction updateLabels() {\n  ["eden", "lagoon"].forEach((key) => {\n    const u = worldOf(key);\n    if (!u) return;\n    if (!labels[key]) {\n      labels[key] = makeLabel(768, 256);\n      scene.add(labels[key].sprite);\n    }\n    paintLabel(labels[key], key, u);\n  });\n  placeLabels();\n}\n\nfunction placeLabels() {\n  if (!labels.eden || !labels.lagoon) return;\n  // on a phone the stacked dioramas have no room for the paper labels;\n  // the readout below already names both worlds\n  const on = mode.view === "table" && !!state && !tablePortrait();\n  labels.eden.sprite.visible = on;\n  labels.lagoon.sprite.visible = on;\n  if (!on) return;\n  ["eden", "lagoon"].forEach((key) => {\n    const slot = tableSlot