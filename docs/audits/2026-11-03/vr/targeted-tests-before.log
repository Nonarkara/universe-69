r.set(dir[0], dir[1], dir[2]).normalize();\n}\n\nfunction updateLight(dt, t) {\n  const k = 1 - Math.exp(-dt * 2.2);\n  LIGHT.top.lerp(LIGHT_T.top, k);\n  LIGHT.horizon.lerp(LIGHT_T.horizon, k);\n  LIGHT.sun.lerp(LIGHT_T.sun, k);\n  LIGHT.night = lerp(LIGHT.night, LIGHT_T.night, k);\n  LIGHT.sunI = lerp(LIGHT.sunI, LIGHT_T.sunI, k);\n  LIGHT.hemiI = lerp(LIGHT.hemiI, LIGHT_T.hemiI, k);\n  LIGHT.exposure = lerp(LIGHT.exposure, LIGHT_T.exposure, k);\n  LIGHT.dir.lerp(LIGHT_T.dir, k).normalize();\n  if (!sky) return;\n  const u = sky.material.uniforms;\n  u.uTop.value.copy(LIGHT.top);\n  u.uHorizon.value.copy(LIGHT.horizon);\n  u.uSun.value.copy(LIGHT.sun);\n  u.uSunDir.value.copy(LIGHT.dir);\n  u.uNight.value = LIGHT.night;\n  u.uTime.value = t;\n  sunLight.color.copy(LIGHT.sun);\n  sunLight.intensity = LIGHT.sunI;\n  hemi.color.copy(LIGHT.top).lerp(WHITE, 0.35);\n  hemi.intensity = LIGHT.hemiI;\n  moon.intensity = 0.55 * LIGHT.night;\n  renderer.toneMappingExposure = LIGHT.exposure;\n  const focus = mode.view === "inside" ? player.position : _v.set(0, 0, 0);\n  sunLight.target.position.copy(focus);\n  sunLight.target.updateMatrixWorld();\n  sunLight.position.copy(focus).addScaledVector(LIGHT.dir, 58);\n  moon.position.copy(focus).addScaledVector(LIGHT.dir, -40);\n  moon.position.y = focus.y + 34;\n}\n\nfunction updateSky(t) {\n  if (!sky || !camera) return;\n  const p = camera.getWorldPosition(_v);\n  sky.position.copy(p);\n  sky.material.uniforms.uTime.value = t;\n  ["eden", "lagoon"].forEach((key) => {\n    const s = worlds[key] && worlds[key].userData.static;\n    const w = s && s.userData.water;\n    if (w) {\n      w.material.uniforms.uTime.value = t;\n      w.material.uniforms.uNight.value = LIGHT.night;\n      w.material.uniforms.uSun.value.copy(LIGHT.sun);\n      w.material.uniforms.uSunDir.value.copy(LIGHT.dir);\n    }\n    if (s && s.userData.fires) {\n      s.userData.fires.forEach((l, i) => {\n        l.intensity = 4.4 + 1.5 * Math.sin(t * 7.3 + i * 2.1)\n                      + 0.7 * Math.sin(t * 13.7 + i);\n      });\n    }\n  });\n  const lamps = worlds.eden && worlds.eden.userData.static\n    && worlds.eden.userData.static.userData.lamps;\n  if (lamps) lamps.visible = !!(state && state.u.eden.night);\n}\n\n// ---- REAL-TIME / CONTINUE: a viewing clock, never a change to the record ----\nfunction setHeld(on) {\n  if (on === held.on) return;\n  held.on = on;\n  if (on) {\n    const e = worldOf("eden");\n    held.atPart = e ? e.part : 0;\n    held.atDay = e ? e.day : 0;\n    held.since = Date.now();\n    pendingState = null; pendingWorld = null;\n    ["eden", "lagoon"].forEach((key) => {\n      const c = worlds[key] && worlds[key].userData.crowd;\n      if (c) c.hold();\n    });\n  } else {\n    ["eden", "lagoon"].forEach((key) => {\n      const c = worlds[key] && worlds[key].userData.crowd;\n      if (c) c.release();\n    });\n    if (pendingState) {\n      state = pendingState;\n      if (pendingWorld) worldInfo = pendingWorld;\n      pendingState = null; pendingWorld = null;\n      onRecord(state);\n    }\n    lastPoll = 0;\n    poll(true);\n  }\n  if (slate) slate.sig = "";\n  updateHUD(); updateNav(); updateSlate();\n  const u = worldOf(mode.view === "inside" ? mode.active : "eden");\n  if (u) applyTime(u);\n}\n\n// ---- input: the documentary eye can be taken over --------------------------\nconst keys = Object.create(null);\nconst canvasEl = $("view");\nlet drag = null;\n\nfunction pointerPos(e) {\n  const r = canvasEl.getBoundingClientRect();\n  return new THREE.Vector2(((e.clientX - r.left) / r.width) * 2 - 1,\n                           -((e.clientY - r.top) / r.height) * 2 + 1);\n}\n\nfunction pickWorld(e) {\n  if (mode.view !== "table" || !state) return;\n  const ray = new THREE.Raycaster();\n  ray.setFromCamera(pointerPos(e), camera);\n  const hits = ray.intersectObjects([worlds.eden, worlds.lagoon], true);\n  for (const hit of hits) {\n    let o = hit.object;\n    while (o && o !== worlds.eden && o !== worlds.lagoon) o = o.parent;\n    if (o === worlds.eden) { enter("eden"); return; }\n    if (o === worlds.lagoon) { enter("lagoon"); return; }\n  }\n}\n\nfunction bindInput() {\n  canvasEl.addEventListener("pointerdown", (e) => {\n    drag = { x: e.clientX, y: e.clientY, moved: 0 };\n    try { canvasEl.setPointerCapture(e.pointerId); } catch (err) {}\n    canvasEl.style.cursor = "grabbing";\n  });\n  canvasEl.addEventListener("pointermove", (e) => {\n    if (!drag) return;\n    const dx = e.clientX - drag.x, dy = e.clientY - drag.y;\n    drag.x = e.clientX; drag.y = e.clientY;\n    drag.moved += Math.abs(dx) + Math.abs(dy);\n    if (mode.view === "table") {\n      orbit.yaw -= dx * 0.005;\n      orbit.pitch = clamp(orbit.pitch + dy * 0.004, 0.12, 1.15);\n    } else {\n      look.yaw -= dx * 0.0032;\n      look.pitch = clamp(look.pitch - dy * 0.0028, -1.15, 1.05);\n    }\n    if (!renderer.xr.isPresenting) placeCamera();\n  });\n  const endDrag = (e) => {\n    const d = drag; drag = null;\n    canvasEl.style.cursor = "grab";\n    if (d && d.moved < 6) pickWorld(e);\n  };\n  canvasEl.addEventListener("pointerup", endDrag);\n  canvasEl.addEventListener("pointercancel", () => { drag = null; });\n  canvasEl.addEventListener("wheel", (e) => {\n    e.preventDefault();\n    if (mode.view === "table") {\n      orbit.dist = clamp(orbit.dist * (1 + Math.sign(e.deltaY) * 0.08), 2.2, 7.5);\n      placeCamera();\n    }\n  }, { passive: false });\n\n  window.addEventListener("keydown", (e) => {\n    const tag = (e.target && e.target.tagName) || "";\n    if (tag === "INPUT" || tag === "TEXTAREA") return;\n    keys[e.key.toLowerCase()] = true;\n    keys[e.key] = true;\n    if (e.key === "Shift") keys.shift = true;\n    const k = e.key.toLowerCase();\n    if (k === "r") { e.preventDefault(); setHeld(!held.on); }\n    else if (k === "t" || e.key === "Escape") { e.preventDefault(); showTable(); }\n    else if (k === "1") enter("eden");\n    else if (k === "2") enter("lagoon");\n    else if (k === "h") $("chrome").classList.toggle("idle");\n  });\n  window.addEventListener("keyup", (e) => {\n    keys[e.key.toLowerCase()] = false;\n    keys[e.key] = false;\n    if (e.key === "Shift") keys.shift = false;\n  });\n  window.addEventListener("blur", () => {\n    for (const k of Object.keys(keys)) keys[k] = false;\n  });\n\n  $("bTable").addEventListener("click", showTable);\n  $("bEden").addEventListener("click", () => enter("eden"));\n  $("bLagoon").addEventListener("click", () => enter("lagoon"));\n  $("bTime").addEventListener("click", () => setHeld(!held.on));\n  $("bVR").addEventListener("click", startVR);\n\n  let lastMove = Date.now();\n  ["pointermove", "pointerdown", "keydown"].forEach((ev) =>\n    window.addEventListener(ev, () => {\n      lastMove = Date.now();\n      const c = $("chrome"); if (c) c.classList.remove("idle");\n    }));\n  setInterval(() => {\n    const c = $("chrome");\n    if (c && Date.now() - lastMove > 14000) c.classList.add("idle");\n  }, 3000);\n\n  window.addEventListener("resize", () => {\n    if (renderer.xr.isPresenting) return;\n    camera.aspect = window.innerWidth / window.innerHeight;\n    camera.updateProjectionMatrix();\n    renderer.setSize(window.innerWidth, window.innerHeight, false);\n    layout();\n  });\n  canvasEl.addEventListener("webglcontextlost", (e) => {\n    e.preventDefault();\n    showError("The graphics context was lost. Reload the page.");\n  });\n}\n\nfunction moveDesktop(dt) {\n  if (mode.view !== "inside" || renderer.xr.isPresenting) return;\n  let f = 0, r = 0;\n  if (keys.w || keys.arrowup) f += 1;\n  if (keys.s || keys.arrowdown) f -= 1;\n  if (keys.d || keys.arrowright) r += 1;\n  if (keys.a || keys.arrowleft) r -= 1;\n  if (!f && !r) return;\n  const len = Math.hypot(f, r); f /= len; r /= len;\n  const speed = (keys.shift ? 4.4 : 2.1) * dt;\n  const sy = Math.sin(look.yaw), cy = Math.cos(look.yaw);\n  const nx = playerAt.x + (-sy * f + cy * r) * speed;\n  const nz = playerAt.z + (-cy * f - sy * r) * speed;\n  const [x, z] = clampToWorld(mode.active, nx, nz);\n  const gy = groundAt(mode.active, x, z);\n  if (gy < -0.35) return;              // no walking on open water\n  playerAt.x = x; playerAt.z = z; playerAt.y = gy;\n  player.position.set(x, gy, z);\n}\n\n// ---- VR: controllers, teleport, a wrist slate ------------------------------\nconst controllers = [];\nconst bPrev = Object.create(null);\nlet lastTurn = 0;\n\nfunction initXR() {\n  if (!renderer.xr) return;\n  for (let i = 0; i < 2; i++) {\n    const c = renderer.xr.getController(i);\n    c.userData.index = i;\n    c.addEventListener("connected", (e) => {\n      c.userData.handed = (e.data && e.data.handedness) || (i ? "right" : "left");\n    });\n    c.addEventListener("selectstart", () => {\n      if (mode.view === "inside") teleportFrom(c);\n    });\n    const geo = new THREE.BufferGeometry().setFromPoints([\n      new THREE.Vector3(0, 0, 0), new THREE.Vector3(0, 0, -1)]);\n    const line = new THREE.Line(geo, new THREE.LineBasicMaterial({\n      color: 0xe4b456, transparent: true, opacity: 0.7 }));\n    line.scale.z = 4.5;\n    c.add(line);\n    scene.add(c);\n    controllers.push(c);\n  }\n  renderer.xr.addEventListener("sessionstart", onXRStart);\n  renderer.xr.addEventListener("sessionend", onXREnd);\n  if (navigator.xr && navigator.xr.isSessionSupported) {\n    navigator.xr.isSessionSupported("immersive-vr").then((ok) => {\n      if (ok) $("bVR").hidden = false;\n    }).catch(() => {});\n  }\n}\n\nfunction onXRStart() {\n  const b = $("bVR"); if (b) b.textContent = "IN VR";\n  try { renderer.xr.setReferenceSpaceType("local-floor"); } catch (e) {}\n  camera.position.set(0, 0, 0);\n  if (mode.view === "table") {\n    player.position.set(0, 0, 3.1);\n    player.rotation.y = 0;\n  } else {\n    player.position.set(playerAt.x, playerAt.y, playerAt.z);\n    player.rotation.y = look.yaw;\n  }\n}\n\nfunction onXREnd() {\n  const b = $("bVR"); if (b) b.textContent = "ENTER VR";\n  if (mod